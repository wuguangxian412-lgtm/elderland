{
  "name": "Elderland Flutter Codespace",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "flutter doctor -v || true && flutter pub get || true",
  "postStartCommand": "cd /workspaces/elderland && nohup flutter run -d web-server --web-port 8080 --release > /tmp/flutter_web.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "eamodio.gitlens",
        "usernamehw.errorlens"
      ]
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Flutter Web",
      "description": "Flutter Web 预览",
      "onAutoForward": "openBrowser"
    }
  }
}
